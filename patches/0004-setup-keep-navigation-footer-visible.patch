+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (getResources().getBoolean(R.bool.config_pinNavigationFooter)) {
+            post(this::pinToFooter);
+        }
+    }
+
+    private void pinToFooter() {
+        if (!isAttachedToWindow()) return;
+        View footer = getRootView().findViewById(
+                com.google.android.setupcompat.R.id.suc_layout_footer);
+        if (!(footer instanceof ViewStub) || !(getParent() instanceof ViewGroup)) return;
+
+        // Keep the existing controls and listeners outside GLIF's scrolling content.
+        ViewStub stub = (ViewStub) footer;
+        stub.setLayoutResource(R.layout.setup_navigation_footer);
+        ViewGroup container = (ViewGroup) stub.inflate();
+        ((ViewGroup) getParent()).removeView(this);
+        container.addView(this, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
