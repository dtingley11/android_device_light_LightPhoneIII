+        final List<SizeF> widgetSizes = options == null ? null
+                : options.getParcelableArrayList(OPTION_APPWIDGET_SIZES, SizeF.class);
+        final Map<SizeF, RemoteViews> viewsBySize = new LinkedHashMap<>();
+        if (widgetSizes != null && widgetSizes.size() <= 16) {
+            for (SizeF size : widgetSizes) {
+                if (size == null || !Float.isFinite(size.getWidth())
+                        || !Float.isFinite(size.getHeight())
+                        || size.getWidth() <= 0 || size.getHeight() <= 0) {
+                    continue;
+                }
+                // Width and height extrema may belong to different orientations.
+                // Size each layout against an actual pair supplied by the host.
+                final Bundle bounds = new Bundle(options);
+                bounds.putInt(OPTION_APPWIDGET_MIN_WIDTH, (int) size.getWidth());
+                bounds.putInt(OPTION_APPWIDGET_MAX_HEIGHT, (int) size.getHeight());
+                viewsBySize.put(size, relayoutWidget(context, wm, widgetId, bounds, true));
+            }
+        }
+        final RemoteViews widget;
+        if (viewsBySize.isEmpty()) {
+            final RemoteViews portrait = relayoutWidget(context, wm, widgetId, options, true);
