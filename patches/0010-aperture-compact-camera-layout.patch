+    private fun configureCompactLayout() {
+        val primaryBar = findViewById<ConstraintLayout>(R.id.primaryBarLayout)
+        primaryBar.setPadding(0, 0, 0, 0)
+        primaryBar.setBackgroundColor(0x66000000)
+        cameraModeSelectorLayout.setBackgroundColor(0x66000000)
+        findViewById<ConstraintLayout>(R.id.secondaryBottomBarLayout).setBackgroundColor(0x66000000)
+        shutterButton.scaleType = ImageView.ScaleType.FIT_CENTER
+        shutterButton.setPadding(4.px)
+        flipCameraButton.scaleType = ImageView.ScaleType.FIT_CENTER
+        flipCameraButton.setPadding(6.px)
+        videoRecordingStateButton.scaleType = ImageView.ScaleType.FIT_CENTER
+        videoRecordingStateButton.setPadding(8.px)
+
+        ConstraintSet().apply {
+            clone(mainLayout)
+            constrainHeight(R.id.primaryBarLayout, 64.px)
+            clear(R.id.primaryBarLayout, ConstraintSet.BOTTOM)
+            connect(R.id.primaryBarLayout, ConstraintSet.BOTTOM, ConstraintSet.PARENT_ID, ConstraintSet.BOTTOM)
+            clear(R.id.cameraModeSelectorLayout, ConstraintSet.BOTTOM)
+            connect(R.id.cameraModeSelectorLayout, ConstraintSet.BOTTOM, R.id.primaryBarLayout, ConstraintSet.TOP)
+            clear(R.id.viewFinder, ConstraintSet.BOTTOM)
+            connect(R.id.viewFinder, ConstraintSet.BOTTOM, ConstraintSet.PARENT_ID, ConstraintSet.BOTTOM)
+            constrainHeight(R.id.secondaryBottomBarLayout, 48.px)
+            clear(R.id.secondaryBottomBarLayout, ConstraintSet.BOTTOM)
+            connect(R.id.secondaryBottomBarLayout, ConstraintSet.BOTTOM, R.id.cameraModeSelectorLayout, ConstraintSet.TOP)
+            clear(R.id.zoomLevel, ConstraintSet.BOTTOM)
+            connect(R.id.zoomLevel, ConstraintSet.BOTTOM, R.id.secondaryBottomBarLayout, ConstraintSet.TOP, 8.px)
+            clear(R.id.islandView, ConstraintSet.TOP)
+            connect(R.id.islandView, ConstraintSet.TOP, ConstraintSet.PARENT_ID, ConstraintSet.TOP, 12.px)
+            applyTo(mainLayout)
+        }
+
+        ConstraintSet().apply {
+            clone(primaryBar)
+            for (id in intArrayOf(
+                R.id.shutterButton, R.id.galleryButtonCardView, R.id.flipCameraButton,
+                R.id.videoRecordingStateButton
+            )) {
+                val size = if (id == R.id.shutterButton) 56.px else 48.px
+                constrainWidth(id, size)
+                constrainHeight(id, size)
+            }
+            applyTo(primaryBar)
+        }
+
+        mainLayout.addOnLayoutChangeListener { _, left, top, right, bottom,
+                                               oldLeft, oldTop, oldRight, oldBottom ->
+            if (right - left != oldRight - oldLeft || bottom - top != oldBottom - oldTop) {
+                viewFinder.post { fillCompactPreview() }
+            }
+        }
+    }
+
+    private fun fillCompactPreview() {
+        val transform = viewFinder.outputTransform ?: return
+        if (mainLayout.width <= 0 || mainLayout.height <= 0) return
+
+        val imageBounds = RectF(-1f, -1f, 1f, 1f)
+        transform.matrix.mapRect(imageBounds)
+        val aspectRatio = imageBounds.width() / imageBounds.height()
+        if (!aspectRatio.isFinite() || aspectRatio <= 0f) return
+
+        // Fill the display by clipping the view, preserving CameraX's FIT capture viewport.
+        val width = maxOf(mainLayout.width, kotlin.math.ceil(mainLayout.height * aspectRatio).toInt())
+        val height = maxOf(mainLayout.height, kotlin.math.ceil(mainLayout.width / aspectRatio).toInt())
+        if (viewFinder.layoutParams.width == width && viewFinder.layoutParams.height == height) return
+        viewFinder.updateLayoutParams<ConstraintLayout.LayoutParams> {
+            this.width = width
+            this.height = height
+        }
+    }
+
